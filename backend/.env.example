# ===================================================================
# 环境变量示例文件 —— 请复制本文件为 .env 并填入真实值
#
#   Windows CMD:  copy .env.example .env
#   PowerShell:   Copy-Item .env.example .env
#
# 重要：spring-dotenv 从「启动后端时的工作目录」读取 .env。
#       即运行 `cd backend && mvn spring-boot:run` 时，.env 必须在 backend/ 下。
#
# 注意：.env 文件已被 .gitignore 忽略，不会进入版本库，
#       请勿将真实密钥提交到 git。
# ===================================================================

# --- 火山方舟（豆包大模型）API 密钥 ---
# 控制台地址：https://console.volcengine.com/ark
# 用于 AI 推荐和 AI 聊天功能。不填则 AI 模块会返回兜底数据。
ARK_API_KEY=

# --- MySQL 数据库账号 ---
DB_USERNAME=root
DB_PASSWORD=

# --- RAG 知识库（可选）---
# RAG_PYTHON=python
# RAG_PORT=9001
